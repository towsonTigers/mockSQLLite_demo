{
  "name": "taskflow-backend",
  "version": "1.0.0",
  "description": "TaskFlow API - demonstrates SQLite-based end-to-end testing patterns",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
